# Variables de entorno para Club Halcones
#
# Copia este archivo como .env.local y rellena tus valores.
# IMPORTANTE: guarda .env.local en UTF-8. Si se guarda en UTF-16, Next no puede
# parsearlo y ninguna de estas variables llega a cargarse.

# --- Supabase -------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Solo servidor: salta RLS, nunca debe llegar al navegador (por eso no lleva
# el prefijo NEXT_PUBLIC_). Dashboard > Settings > API Keys.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# --- Administración -------------------------------------------------------

# Lista blanca (separada por comas) de quién puede usar las rutas /api/admin.
# Si se deja vacía, vale cualquier usuario autenticado de Supabase Auth, lo
# cual solo es seguro mientras el registro público siga desactivado.
ADMIN_EMAILS=admin@ejemplo.com

# Minutos de inactividad antes del cierre de sesión automático.
NEXT_PUBLIC_AUTO_LOGOUT_MINUTES=10
